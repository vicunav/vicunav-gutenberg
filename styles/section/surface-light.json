{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "slug": "surface-light",
  "title": "Superficie clara",
  "description": "Fondo principal claro con texto oscuro.",
  "blockTypes": [
    "core/group",
    "core/columns",
    "core/cover"
  ],
  "styles": {
    "color": {
      "background": "var:preset|color|neutral-100",
      "text": "var:preset|color|text"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var:preset|color|neutral-700"
        },
        ":hover": {
          "color": {
            "text": "var:preset|color|neutral-800"
          }
        }
      }
    }
  }
}
