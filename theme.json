          "fontSize": "var:preset|font-size|body",
          "fontWeight": "500",
          "letterSpacing": "1px",
          "lineHeight": "1",
          "textDecoration": "none",
          "textTransform": "none"
        }
      },
      "h1": {
        "typography": {
          "fontFamily": "var:preset|font-family|heading",
          "fontSize": "var:preset|font-size|heading-large",
          "fontWeight": "400",
