msgctxt "Contenido del paquete Completo."
msgid "Diseño limpio y profesional"
msgstr "Clean, professional design"

msgctxt "Contenido del paquete Completo."
msgid "Diseño optimizado para móvil"
msgstr "Mobile-optimized design"

msgctxt "Contenido del paquete Completo."
msgid "Formulario de contacto e integración de Whatsapp"
msgstr "Contact form and WhatsApp integration"

msgctxt "Contenido del paquete Completo."
msgid "Estructura preparada para que Google y sistemas de IA"
